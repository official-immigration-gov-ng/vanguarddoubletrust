rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function profileKeysAllowed(profile) {
      return profile is map
        && profile.keys().hasOnly(['firstname', 'lastname', 'phone', 'address', 'country', 'state', 'city', 'zip']);
    }

    match /users/{uid} {
      allow read: if isAdmin() || isSelf(uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          isSelf(uid)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['profile', 'updatedAt'])
          && (
            !('profile' in request.resource.data)
            || profileKeysAllowed(request.resource.data.profile)
          )
        );

      match /transactions/{txId} {
        allow read: if isAdmin() || isSelf(uid);
        allow create: if isAdmin()
          || (
            isSelf(uid)
            && request.resource.data.keys().hasOnly([
              'type',
              'amount',
              'currency',
              'status',
              'createdAt',
              'note',
              'to',
              'from',
              'reference'
            ])
            && request.resource.data.amount is number
            && request.resource.data.amount > 0
            && request.resource.data.status == 'PENDING'
          );
        allow update, delete: if isAdmin();
      }
    }

    match /transactions/{txId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
